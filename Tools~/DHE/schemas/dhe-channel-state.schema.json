{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-channel-state.schema.json",
  "title": "HybridCLR DHE Protected Channel State",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "format", "storageContract", "generatedAtUtc", "operation",
    "channelId", "releaseRevision", "previousChannelHeadSha256",
    "releaseLedgerSha256", "parentReleaseLedgerSha256",
    "resourceUpdateManifestSha256", "resourceUpdateValidationSha256",
    "baseRegistryId", "baseRegistryRevision", "baseRegistrySha256",
    "activeBaseCount", "retiredBaseCount", "currentAssemblySetSha256",
    "payloadVariantSetSha256", "artifactRelativeRoot", "artifactTreeSha256",
    "approvalKind", "releaseGateRelativePath", "releaseGateSha256",
    "toolchainPackageId", "exactActiveBaseCoverage", "playerReportCount",
    "engineMatrixCovered", "engineWorkflows"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-channel-state.json" },
    "storageContract": { "const": "filesystem-cas-v1" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "operation": { "enum": ["adopted-existing-head", "promoted"] },
    "channelId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "releaseRevision": { "type": "integer", "minimum": 1 },
    "previousChannelHeadSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "releaseLedgerSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "parentReleaseLedgerSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "resourceUpdateManifestSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "resourceUpdateValidationSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "baseRegistryId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "baseRegistryRevision": { "type": "integer", "minimum": 1 },
    "baseRegistrySha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "activeBaseCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "retiredBaseCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "currentAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "payloadVariantSetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "artifactRelativeRoot": { "type": "string", "pattern": "^artifacts/[0-9a-fA-F]{64}/[0-9a-fA-F]{64}$" },
    "artifactTreeSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "approvalKind": { "enum": ["adopted-existing-head", "resource-release-gate"] },
    "releaseGateRelativePath": { "type": ["string", "null"], "pattern": "^approvals/[0-9a-fA-F]{64}\\.json$" },
    "releaseGateSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "toolchainPackageId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "exactActiveBaseCoverage": { "type": "boolean" },
    "playerReportCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "engineMatrixCovered": { "type": "boolean" },
    "engineWorkflows": {
      "type": "array", "minItems": 1, "maxItems": 3, "uniqueItems": true,
      "items": { "enum": ["Unity2021Standard", "Unity2022Fgs", "Tuanjie2022Fgs"] }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "operation": { "const": "adopted-existing-head" } }, "required": ["operation"] },
      "then": {
        "properties": {
          "previousChannelHeadSha256": { "type": "null" },
          "approvalKind": { "const": "adopted-existing-head" },
          "releaseGateRelativePath": { "type": "null" },
          "releaseGateSha256": { "type": "null" },
          "exactActiveBaseCoverage": { "const": false },
          "playerReportCount": { "const": 0 },
          "engineMatrixCovered": { "const": false }
        }
      },
      "else": {
        "properties": {
          "approvalKind": { "const": "resource-release-gate" },
          "releaseGateRelativePath": { "type": "string" },
          "releaseGateSha256": { "type": "string" },
          "exactActiveBaseCoverage": { "const": true },
          "playerReportCount": { "minimum": 1 }
        }
      }
    }
  ]
}
