{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-device-player-run.schema.json",
  "title": "HybridCLR DHE Device Player Run",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "format", "generatedAtUtc", "passed", "target",
    "deviceSerial", "deviceState", "deviceDescription", "deviceModel",
    "deviceProduct", "deviceApiLevel", "deviceAbi", "adbPath", "adbVersion",
    "apkPath", "apkSha256", "applicationId", "activity", "processId",
    "uniqueProcessId", "processExited", "baseBuildIdentity",
    "baseBuildIdentitySha256", "selectedBaseId", "resourceUpdateRoot",
    "resourceUpdateManifest", "resourceUpdateManifestSha256", "releaseLedger",
    "releaseLedgerSha256", "stageReport", "stageReportSha256",
    "stagedAssetRoot", "stagedFileCount", "stagedFiles", "remoteAssetRoot",
    "playerResult", "playerResultSha256", "playerPassed",
    "selectedPayloadVariantId", "selectedCurrentAssemblySetSha256", "logcat",
    "logcatSha256", "installValidated", "payloadPushValidated",
    "payloadRoundTripValidated", "launchValidated", "elapsedMilliseconds",
    "errors", "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-device-player-run.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "const": true },
    "target": { "const": "Android" },
    "deviceSerial": { "type": "string", "minLength": 1 },
    "deviceState": { "const": "device" },
    "deviceDescription": { "type": "string" },
    "deviceModel": { "type": "string", "minLength": 1 },
    "deviceProduct": { "type": "string", "minLength": 1 },
    "deviceApiLevel": { "type": "integer", "minimum": 21 },
    "deviceAbi": { "type": "string", "minLength": 1 },
    "adbPath": { "type": "string", "minLength": 1 },
    "adbVersion": { "type": "string", "minLength": 1 },
    "apkPath": { "type": "string", "minLength": 1 },
    "apkSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "applicationId": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]*(\\.[A-Za-z][A-Za-z0-9_]*)+$" },
    "activity": { "type": "string", "minLength": 2 },
    "processId": { "type": "integer", "minimum": 1 },
    "uniqueProcessId": { "const": true },
    "processExited": { "const": true },
    "baseBuildIdentity": { "type": "string", "minLength": 1 },
    "baseBuildIdentitySha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "selectedBaseId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "resourceUpdateRoot": { "type": "string", "minLength": 1 },
    "resourceUpdateManifest": { "type": "string", "minLength": 1 },
    "resourceUpdateManifestSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "releaseLedger": { "type": "string", "minLength": 1 },
    "releaseLedgerSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "stageReport": { "type": "string", "minLength": 1 },
    "stageReportSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "stagedAssetRoot": { "type": "string", "minLength": 1 },
    "stagedFileCount": { "type": "integer", "minimum": 5 },
    "stagedFiles": {
      "type": "array",
      "minItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "remoteAssetRoot": { "type": "string", "pattern": "^/sdcard/Android/data/.+/files/.+$" },
    "playerResult": { "type": "string", "minLength": 1 },
    "playerResultSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "playerPassed": { "const": true },
    "selectedPayloadVariantId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
    "selectedCurrentAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "logcat": { "type": "string", "minLength": 1 },
    "logcatSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "installValidated": { "const": true },
    "payloadPushValidated": { "const": true },
    "payloadRoundTripValidated": { "const": true },
    "launchValidated": { "const": true },
    "elapsedMilliseconds": { "type": "integer", "minimum": 0 },
    "errors": { "type": "array", "maxItems": 0 },
    "warnings": { "type": "array" }
  }
}
