{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-resource-release-plan.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "generatedAtUtc", "passed", "releaseReady", "pathSemantics", "configuration", "configurationSha256", "runnerCatalog", "runnerCatalogSha256", "toolchainRoot", "toolchainPackageId", "toolchainSourceHead", "toolchainSourceTree", "resourceUpdateRoot", "resourceUpdateManifest", "resourceUpdateManifestSha256", "resourceUpdateValidation", "resourceUpdateValidationSha256", "releaseChannelId", "releaseRevision", "releaseLedgerSha256", "parentReleaseLedgerSha256", "channelSnapshot", "channelSnapshotSha256", "channelStateRoot", "expectedChannelHeadSha256", "baseRegistryId", "baseRegistryRevision", "baseRegistrySha256", "activeBaseCount", "processRunnerCount", "prequalifiedRunnerCount", "evidenceToolchainPackageIds", "requireEngineMatrix", "engineMatrixCovered", "exactActiveBaseCoverage", "qualificationConfig", "qualificationConfigSha256", "qualificationOutputRoot", "jobs", "errors", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-resource-release-plan.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "const": true },
    "releaseReady": { "const": true },
    "pathSemantics": { "const": "plan-owned-relative-external-absolute-v1" },
    "configuration": { "const": "audit/dhe-resource-release-plan-config.json" },
    "configurationSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "runnerCatalog": { "const": "audit/dhe-base-runner-catalog.json" },
    "runnerCatalogSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "toolchainRoot": { "type": "string", "minLength": 1 },
    "toolchainPackageId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "toolchainSourceHead": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "toolchainSourceTree": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "resourceUpdateRoot": { "type": "string", "minLength": 1 },
    "resourceUpdateManifest": { "type": "string", "minLength": 1 },
    "resourceUpdateManifestSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "resourceUpdateValidation": { "type": "string", "minLength": 1 },
    "resourceUpdateValidationSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "releaseChannelId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "releaseRevision": { "type": "integer", "minimum": 1 },
    "releaseLedgerSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "parentReleaseLedgerSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "channelSnapshot": { "type": "string", "minLength": 1 },
    "channelSnapshotSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "channelStateRoot": { "type": "string", "minLength": 1 },
    "expectedChannelHeadSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "baseRegistryId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "baseRegistryRevision": { "type": "integer", "minimum": 1 },
    "baseRegistrySha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "activeBaseCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "processRunnerCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "prequalifiedRunnerCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "evidenceToolchainPackageIds": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
    },
    "requireEngineMatrix": { "type": "boolean" },
    "engineMatrixCovered": { "type": "boolean" },
    "exactActiveBaseCoverage": { "const": true },
    "qualificationConfig": { "const": "dhe-resource-release-qualification-config.json" },
    "qualificationConfigSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "qualificationOutputRoot": { "type": "string", "minLength": 1 },
    "jobs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseId", "runnerKind", "engineWorkflow", "target", "payloadVariantId", "expectedChangedMethodCount", "playerWorkflowReport"],
        "properties": {
          "baseId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "runnerKind": { "enum": ["process", "prequalified"] },
          "engineWorkflow": { "enum": ["Unity2021Standard", "Unity2022Fgs", "Tuanjie2022Fgs"] },
          "target": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "payloadVariantId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "expectedChangedMethodCount": { "type": "integer", "minimum": 0 },
          "playerWorkflowReport": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "errors": { "type": "array", "maxItems": 0 },
    "warnings": { "type": "array", "maxItems": 1, "items": { "type": "string" } }
  }
}
