{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-adapter-native-guards.schema.json",
  "title": "HybridCLR DHE Adapter Native Guard Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "generatedAtUtc", "passed", "target", "generatedCppRoot", "manifestPath", "requestedMethodCount", "transformedMethodCount", "nativeEntryCount", "unsupportedMethodCount", "guardMode", "guardedMethodCount", "supportedGuardedMethodCount", "unsupportedGuardedMethodCount", "interpreterOnlyMethodCount", "unsupportedChangedMethodCount"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-adapter-native-guards.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "const": true },
    "target": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "generatedCppRoot": { "type": "string", "minLength": 1 },
    "manifestPath": { "type": "string", "minLength": 1 },
    "requestedMethodCount": { "type": "integer", "minimum": 0 },
    "transformedMethodCount": { "type": "integer", "minimum": 0 },
    "nativeEntryCount": { "type": "integer", "minimum": 0 },
    "unsupportedMethodCount": { "const": 0 },
    "guardMode": { "enum": ["changed-only", "universal"] },
    "guardedMethodCount": { "type": "integer", "minimum": 0 },
    "supportedGuardedMethodCount": { "type": "integer", "minimum": 0 },
    "unsupportedGuardedMethodCount": { "type": "integer", "minimum": 0 },
    "interpreterOnlyMethodCount": { "type": "integer", "minimum": 0 },
    "unsupportedChangedMethodCount": { "type": "integer", "minimum": 0 }
  }
}
