{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-project-preflight.schema.json",
  "title": "HybridCLR DHE Project Preflight Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "passed", "generationPassed", "validationPassed", "coverageRequired", "dheCoverageRequired", "configurationPassed", "configurationErrors", "hotUpdateAssemblies", "dheAotAssemblies", "dheEqualsHotUpdate", "coverageComplete", "artifactReady", "releaseReady", "sourcePreflight", "sourcePreflightPassed", "batchReport", "projectPlan", "projectPlanValidation", "counts", "assemblies", "nativeAbiCoverage", "dnlibPath"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-project-preflight.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "type": "boolean" },
    "generationPassed": { "type": "boolean" },
    "validationPassed": { "type": "boolean" },
    "coverageRequired": { "type": "boolean" },
    "dheCoverageRequired": { "type": "boolean" },
    "configurationPassed": { "type": "boolean" },
    "configurationErrors": { "type": "array", "items": { "type": "string" } },
    "hotUpdateAssemblies": { "type": "array", "items": { "type": "string" } },
    "dheAotAssemblies": { "type": "array", "items": { "type": "string" } },
    "dheEqualsHotUpdate": { "type": ["boolean", "null"] },
    "coverageComplete": { "type": "boolean" },
    "artifactReady": { "type": "boolean" },
    "releaseReady": { "type": "boolean" },
    "sourcePreflight": { "type": ["string", "null"] },
    "sourcePreflightPassed": { "type": ["boolean", "null"] },
    "batchReport": { "type": "string", "minLength": 1 },
    "projectPlan": { "type": "string", "minLength": 1 },
    "projectPlanValidation": { "type": "string", "minLength": 1 },
    "nativeAbiCoverage": { "const": "not-evaluated-by-offline-preflight" },
    "dnlibPath": { "type": "string", "minLength": 1 },
    "counts": { "type": "object" },
    "assemblies": { "type": "array" }
  }
}
