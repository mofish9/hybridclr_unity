{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-project-preflight-failure.schema.json",
  "title": "HybridCLR DHE Project Preflight Failure Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "passed", "generationPassed", "validationPassed", "coverageRequired", "dheCoverageRequired", "sourcePreflightPassed", "settingsFile", "projectRoot", "baselineRoot", "currentRoot", "outputRoot", "error", "errors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-project-preflight-failure.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "const": false },
    "generationPassed": { "const": false },
    "validationPassed": { "const": false },
    "coverageRequired": { "type": "boolean" },
    "dheCoverageRequired": { "type": "boolean" },
    "sourcePreflight": { "type": ["string", "null"] },
    "sourcePreflightPassed": { "type": "boolean" },
    "settingsFile": { "type": "string", "minLength": 1 },
    "projectRoot": { "type": "string", "minLength": 1 },
    "baselineRoot": { "type": "string", "minLength": 1 },
    "currentRoot": { "type": "string", "minLength": 1 },
    "outputRoot": { "type": "string", "minLength": 1 },
    "dnlibPath": { "type": ["string", "null"] },
    "error": { "type": "string", "minLength": 1 },
    "errors": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
