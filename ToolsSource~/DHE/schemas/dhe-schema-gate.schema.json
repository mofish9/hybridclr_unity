{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-schema-gate.schema.json",
  "title": "HybridCLR DHE Schema Gate Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "generatedAtUtc", "passed", "schemaCount", "documentCount", "skippedDocumentCount", "inputRoots", "schemaRoots", "schemas", "documents", "errors", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-schema-gate.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "type": "boolean" },
    "schemaCount": { "type": "integer", "minimum": 1 },
    "documentCount": { "type": "integer", "minimum": 1 },
    "skippedDocumentCount": { "type": "integer", "minimum": 0 },
    "inputRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "schemaRoots": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "schemas": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "id", "format", "formatPattern", "supported", "errors"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "id": { "type": ["string", "null"] },
          "format": { "type": ["string", "null"] },
          "formatPattern": { "type": ["string", "null"] },
          "supported": { "type": "boolean" },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "format", "schema", "status", "passed", "errors"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "format": { "type": ["string", "null"] },
          "schema": { "type": ["string", "null"] },
          "status": { "enum": ["validated", "skipped", "error"] },
          "passed": { "type": "boolean" },
          "errors": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "passed": { "const": true } } },
      "then": { "properties": { "errors": { "maxItems": 0 } } }
    }
  ]
}
