{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/test-manifest.schema.json",
  "title": "HybridCLR Lab Test Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "suiteId", "cases"],
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "suiteId": {
      "type": "string",
      "minLength": 1
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "category", "layer", "features", "required"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9_]+$"
          },
          "category": {
            "type": "string",
            "minLength": 1
          },
          "layer": {
            "enum": ["managed-core", "player-boundary"]
          },
          "features": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 },
            "uniqueItems": true
          },
          "required": {
            "type": "boolean"
          }
        }
      }
    }
  }
}
