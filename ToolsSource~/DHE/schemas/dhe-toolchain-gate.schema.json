{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-toolchain-gate.schema.json",
  "title": "HybridCLR DHE Toolchain Package Gate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "generatedAtUtc", "passed", "packageRoot", "manifest", "toolchainVersion", "contractVersion", "packageId", "computedPackageId", "packageIdAlgorithm", "expectedPackageId", "packageIdValid", "packageTreeSafe", "releaseReady", "releaseIdentityValid", "requireRelease", "expectedFileCount", "actualFileCount", "hashesValid", "scriptsValid", "jsonValid", "schemaValid", "layoutValid", "boundaryValid", "errors", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-toolchain-gate.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "type": "boolean" },
    "packageRoot": { "type": "string" },
    "manifest": { "type": ["string", "null"] },
    "toolchainVersion": { "type": ["string", "null"] },
    "contractVersion": { "type": ["integer", "null"] },
    "packageId": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "computedPackageId": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "packageIdAlgorithm": { "const": "sha256-canonical-manifest-v2" },
    "expectedPackageId": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "packageIdValid": { "type": "boolean" },
    "packageTreeSafe": { "type": "boolean" },
    "releaseReady": { "type": "boolean" },
    "releaseIdentityValid": { "type": "boolean" },
    "requireRelease": { "type": "boolean" },
    "expectedFileCount": { "type": "integer", "minimum": 0 },
    "actualFileCount": { "type": "integer", "minimum": 0 },
    "hashesValid": { "type": "boolean" },
    "scriptsValid": { "type": "boolean" },
    "jsonValid": { "type": "boolean" },
    "schemaValid": { "type": "boolean" },
    "layoutValid": { "type": "boolean" },
    "boundaryValid": { "type": "boolean" },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
