{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-clean-checkout-gate.schema.json",
  "title": "HybridCLR DHE Clean Checkout Gate Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "passed", "cleanSourcePreflightPassed", "staleOutputRejected", "missingRuntimeRejected", "runtimeTested", "staleManifestTested", "staleManifestRejected", "gitTested", "gitHead", "gitTree", "gitCleanRequired", "trackedSourcesTested", "trackedSourcesRequired", "sourceBoundaryPath", "sourceBoundarySha256", "missingTrackedSources", "projectGit", "toolGit", "errors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-clean-checkout-gate.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "pathSemantics": { "enum": ["workspace-absolute-v1", "archive-relative-v1"] },
    "passed": { "type": "boolean" },
    "cleanSourcePreflightPassed": { "type": "boolean" },
    "staleOutputRejected": { "type": "boolean" },
    "missingRuntimeRejected": { "type": "boolean" },
    "runtimeTested": { "type": "boolean" },
    "staleManifestTested": { "type": "boolean" },
    "staleManifestRejected": { "type": ["boolean", "null"] },
    "gitRoot": { "type": ["string", "null"] },
    "gitTested": { "type": "boolean" },
    "gitHead": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40,64}$" },
    "gitTree": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40,64}$" },
    "gitClean": { "type": ["boolean", "null"] },
    "vcs": { "enum": ["git", "svn", null] },
    "vcsRoot": { "type": ["string", "null"] },
    "vcsRevision": { "type": ["string", "null"], "pattern": "^(?:[0-9]+)?$" },
    "vcsRevisionSpec": { "type": ["string", "null"] },
    "vcsRepository": { "type": ["string", "null"] },
    "gitCleanRequired": { "type": "boolean" },
    "trackedSourcesTested": { "type": "boolean" },
    "trackedSourcesComplete": { "type": ["boolean", "null"] },
    "trackedSourcesRequired": { "type": "boolean" },
    "sourceBoundaryPath": { "type": ["string", "null"] },
    "sourceBoundarySha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "missingTrackedSources": { "type": "array", "items": { "type": "string" } },
    "projectGit": { "anyOf": [{ "$ref": "#/$defs/gitIdentity" }, { "type": "null" }] },
    "toolGit": { "anyOf": [{ "$ref": "#/$defs/gitIdentity" }, { "type": "null" }] },
    "errors": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "gitIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "tested", "root", "ownedPath", "head", "tree", "clean", "cleanRequired", "trackedSourcesTested", "trackedSourcesComplete", "trackedSourcesRequired", "sourceBoundaryPath", "sourceBoundarySha256", "missingTrackedSources", "passed", "errors", "warnings"],
      "properties": {
        "name": { "enum": ["project", "tool"] },
        "vcs": { "enum": ["git", "svn"] },
        "tested": { "const": true },
        "root": { "type": ["string", "null"] },
        "ownedPath": { "type": ["string", "null"] },
        "head": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40,64}$" },
        "tree": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40,64}$" },
        "revision": { "type": ["string", "null"], "pattern": "^(?:[0-9]+)?$" },
        "revisionSpec": { "type": ["string", "null"] },
        "repository": { "type": ["string", "null"] },
        "clean": { "type": ["boolean", "null"] },
        "cleanRequired": { "type": "boolean" },
        "trackedSourcesTested": { "type": "boolean" },
        "trackedSourcesComplete": { "type": ["boolean", "null"] },
        "trackedSourcesRequired": { "type": "boolean" },
        "sourceBoundaryPath": { "type": ["string", "null"] },
        "sourceBoundarySha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
        "sourceBoundaryPathBase": { "enum": ["git-root-v1", "manifest-directory-v1", "project-root-v1", null] },
        "missingTrackedSources": { "type": "array", "items": { "type": "string" } },
        "passed": { "type": "boolean" },
        "errors": { "type": "array", "items": { "type": "string" } },
        "warnings": { "type": "array", "items": { "type": "string" } }
      }
    }
  }
}
