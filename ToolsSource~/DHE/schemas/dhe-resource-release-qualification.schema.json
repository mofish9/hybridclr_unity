{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-resource-release-qualification.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "generatedAtUtc", "passed", "releaseReady", "pathSemantics", "configuration", "configurationSha256", "toolchainRoot", "toolchainPackageId", "resourceUpdateRoot", "resourceUpdateManifest", "resourceUpdateManifestSha256", "resourceUpdateValidation", "resourceUpdateValidationSha256", "releaseChannelId", "releaseRevision", "releaseLedgerSha256", "channelSnapshot", "channelSnapshotSha256", "activeBaseCount", "processRunnerCount", "prequalifiedRunnerCount", "requireEngineMatrix", "engineMatrixCovered", "exactActiveBaseCoverage", "playerReports", "resourceReleaseGate", "resourceReleaseGateSha256", "promotionRequired", "errors", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-resource-release-qualification.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "const": true },
    "releaseReady": { "const": true },
    "pathSemantics": { "const": "qualification-owned-relative-external-absolute-v1" },
    "configuration": { "type": "string", "minLength": 1 },
    "configurationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "toolchainRoot": { "type": "string", "minLength": 1 },
    "toolchainPackageId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resourceUpdateRoot": { "type": "string", "minLength": 1 },
    "resourceUpdateManifest": { "type": "string", "minLength": 1 },
    "resourceUpdateManifestSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "resourceUpdateValidation": { "type": "string", "minLength": 1 },
    "resourceUpdateValidationSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "releaseChannelId": { "type": "string", "minLength": 1 },
    "releaseRevision": { "type": "integer", "minimum": 1 },
    "releaseLedgerSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "channelSnapshot": { "type": "string", "minLength": 1 },
    "channelSnapshotSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "activeBaseCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "processRunnerCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "prequalifiedRunnerCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "requireEngineMatrix": { "type": "boolean" },
    "engineMatrixCovered": { "type": "boolean" },
    "exactActiveBaseCoverage": { "const": true },
    "playerReports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseId", "runnerKind", "engineWorkflow", "target", "payloadVariantId", "changedMethodCount", "expectedChangedMethodCount", "interpreterEntryCount", "aotEntryCount", "processId", "exitCode", "durationMilliseconds", "assetRoot", "stageReport", "stageReportSha256", "playerResult", "playerResultSha256", "playerLog", "playerWorkflowReport", "playerWorkflowReportSha256", "outputOwned"],
        "properties": {
          "baseId": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "runnerKind": { "enum": ["process", "prequalified"] },
          "engineWorkflow": { "enum": ["Unity2021Standard", "Unity2022Fgs", "Tuanjie2022Fgs"] },
          "target": { "type": "string", "minLength": 1 },
          "payloadVariantId": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$" },
          "changedMethodCount": { "type": "integer", "minimum": 0 },
          "expectedChangedMethodCount": { "type": "integer", "minimum": 0 },
          "interpreterEntryCount": { "type": "integer", "minimum": 0 },
          "aotEntryCount": { "type": "integer", "minimum": 0 },
          "processId": { "type": ["integer", "null"], "minimum": 1 },
          "exitCode": { "type": ["integer", "null"] },
          "durationMilliseconds": { "type": ["integer", "null"], "minimum": 0 },
          "assetRoot": { "type": ["string", "null"] },
          "stageReport": { "type": ["string", "null"] },
          "stageReportSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "playerResult": { "type": ["string", "null"] },
          "playerResultSha256": { "type": ["string", "null"], "pattern": "^[0-9a-f]{64}$" },
          "playerLog": { "type": ["string", "null"] },
          "playerWorkflowReport": { "type": "string", "minLength": 1 },
          "playerWorkflowReportSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
          "outputOwned": { "type": "boolean" }
        }
      }
    },
    "resourceReleaseGate": { "type": "string", "minLength": 1 },
    "resourceReleaseGateSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "promotionRequired": { "const": true },
    "errors": { "type": "array", "maxItems": 0 },
    "warnings": { "type": "array", "items": { "type": "string" } }
  }
}
