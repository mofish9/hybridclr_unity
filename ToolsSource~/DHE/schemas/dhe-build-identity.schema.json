{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-build-identity.schema.json",
  "title": "HybridCLR DHE Build Identity",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "format",
    "workflow",
    "target",
    "engineWorkflow",
    "il2cppCodeGeneration",
    "baseId",
    "managedAssemblySetSha256",
    "aotAssemblySetSha256",
    "aotAssemblyNames",
    "aotSnapshotSha256",
    "aotSnapshotKind",
    "identityVersion",
    "state",
    "pathSemantics",
    "stagedSourcePath",
    "stagedSourceSha256",
    "nativeGuardSourceSha256",
    "nativeManifestSha256",
    "baseMetaVersionSetSha256",
    "aotMetadataSetId",
    "runtimeProtocol",
    "runtimeContract",
    "runtimeCapabilities",
    "runtimeAssetRoot",
    "baseMetaVersionAssetRoot",
    "generatedCppRoot",
    "generatedCppPaths",
    "nativeManifestPath",
    "assemblies"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-build-identity.json" },
    "workflow": { "type": "string", "minLength": 1 },
    "target": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "engineWorkflow": { "enum": ["Unity2021Standard", "Unity2022Fgs", "Tuanjie2022Fgs"] },
    "il2cppCodeGeneration": { "enum": ["OptimizeSpeed", "OptimizeSize"] },
    "baseId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "managedAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "aotAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "aotAssemblyNames": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[^/\\\\]+$", "minLength": 1 }
    },
    "aotSnapshotAssembly": { "type": "string", "minLength": 1 },
    "aotSnapshotSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "aotAnalysisSnapshotSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "aotAnalysisSnapshot": { "type": "string", "pattern": "^aot-analysis/[0-9a-f]{64}/manifest[.]json$" },
    "aotSnapshotKind": { "const": "managed-assembly-plus-generated-cpp-v1" },
    "identityVersion": { "const": 1 },
    "state": { "const": "staged-for-final-player" },
    "pathSemantics": { "enum": ["workspace-absolute-v1", "archive-relative-v1"] },
    "stagedSourcePath": { "type": "string", "minLength": 1 },
    "stagedSourceSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "nativeGuardSourceSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "nativeManifestSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "baseMetaVersionSetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "aotMetadataSetId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "runtimeProtocol": { "const": "dhe-runtime-protocol-v1" },
    "runtimeContract": { "type": "string", "pattern": "^dhe-runtime-v[1-9][0-9]*$" },
    "runtimeCapabilities": {
      "type": "array", "minItems": 2, "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "runtimeAssetRoot": { "type": "string", "minLength": 1 },
    "baseMetaVersionAssetRoot": { "type": "string", "minLength": 1 },
    "generatedCppRoot": { "type": "string", "minLength": 1 },
    "generatedCppPaths": {
      "type": "array",
      "minItems": 0,
      "items": { "type": "string", "minLength": 1 }
    },
    "nativeManifestPath": { "type": "string", "minLength": 1 },
    "assemblies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assemblyName", "baselinePath", "baselineSha256", "snapshotSha256", "baseMetaVersionPath", "baseMetaVersionSha256", "embeddedBaseMetaVersionPath", "embeddedBaseMetaVersionSha256"],
        "properties": {
          "assemblyName": { "type": "string", "minLength": 1 },
          "baselinePath": { "type": "string", "minLength": 1 },
          "baselineSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "snapshotSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
          ,"baseMetaVersionPath": { "type": "string", "minLength": 1 }
          ,"baseMetaVersionSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
          ,"embeddedBaseMetaVersionPath": { "type": "string", "minLength": 1 }
          ,"embeddedBaseMetaVersionSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "runtimeSource": { "type": ["string", "null"] }
  },
  "allOf": [
    { "if": { "required": ["aotAnalysisSnapshotSha256"] }, "then": { "required": ["aotAnalysisSnapshot"] } },
    { "if": { "required": ["aotAnalysisSnapshot"] }, "then": { "required": ["aotAnalysisSnapshotSha256"] } }
  ]
}
