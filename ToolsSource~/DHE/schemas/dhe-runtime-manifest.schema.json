{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-runtime-manifest.schema.json",
  "title": "HybridCLR DHE Runtime Manifest",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "schemaVersion",
    "format",
    "profile",
    "dheEnabled",
    "pathSemantics",
    "createdAtUtc",
    "engineWorkflow",
    "engine",
    "externalHeaders",
    "source",
    "stagedRuntimeSha256",
    "dheRuntimeLockSha256",
    "dhePatches"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-runtime-manifest.json" },
    "profile": { "type": "string", "minLength": 1 },
    "dheEnabled": { "type": "boolean" },
    "pathSemantics": { "enum": ["workspace-absolute-v1", "archive-relative-v1"] },
    "createdAtUtc": { "type": "string", "format": "date-time" },
    "engineWorkflow": { "type": "string", "minLength": 1 },
    "engine": {
      "type": "object",
      "required": ["family", "version", "unityVersion", "unityVersionNumber", "tuanjieVersionNumber"],
      "properties": {
        "family": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 },
        "unityVersion": { "type": "string", "minLength": 1 },
        "unityVersionNumber": { "type": "integer", "minimum": 0 },
        "tuanjieVersionNumber": { "type": "integer", "minimum": 0 },
        "executablePath": { "type": ["string", "null"] }
      }
    },
    "externalHeaders": {
      "type": "object",
      "required": ["sourcePath", "stagedPath", "stagedTreeSha256", "surrogate", "editorAvailable", "explicitlyAllowed"],
      "properties": {
        "sourcePath": { "type": ["string", "null"] },
        "stagedPath": { "type": "string", "minLength": 1 },
        "stagedTreeSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
        "surrogate": { "type": "boolean" },
        "editorAvailable": { "type": "boolean" },
        "explicitlyAllowed": { "type": "boolean" }
      }
    },
    "source": {
      "type": "object",
      "properties": {
        "hybridclr": { "$ref": "#/$defs/source" },
        "il2cpp_plus": { "$ref": "#/$defs/source" },
        "hybridclr_unity": { "$ref": "#/$defs/source" }
      }
    },
    "stagedLibil2cpp": { "type": ["string", "null"] },
    "stagedRuntimeSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "dheRuntimeLock": { "type": ["string", "null"] },
    "dheRuntimeLockSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "dheRuntimeSourceMode": { "enum": ["overlay", "integrated"] },
    "dhePatches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "repository", "baseCommit", "path", "sha256", "applyRoot", "stripComponents"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "repository": { "type": "string", "minLength": 1 },
          "sourceMode": { "enum": ["overlay", "integrated"] },
          "baseCommit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
          "engineWorkflows": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "enum": ["Unity2021Standard", "Unity2022Fgs", "Tuanjie2022Fgs"] }
          },
          "integratedCommit": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40}$" },
          "expectedTreeSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
          "path": { "type": ["string", "null"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "applyRoot": { "enum": ["libil2cpp", "package"] },
          "stripComponents": { "type": "integer", "minimum": 0 }
        }
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "required": ["url", "path", "commit", "dirty", "treeSha256"],
      "properties": {
        "url": { "type": "string", "minLength": 1 },
        "path": { "type": ["string", "null"] },
        "commit": { "type": "string", "pattern": "^[0-9a-fA-F]{40}$" },
        "dirty": { "type": "boolean" },
        "treeSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
      }
    }
  }
}
