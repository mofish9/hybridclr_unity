{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-toolchain-evidence-authorities.schema.json",
  "title": "HybridCLR DHE Toolchain Evidence Authorities",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "policy", "authorities"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-toolchain-evidence-authorities.json" },
    "policy": { "const": "explicit-package-id-set-v1" },
    "authorities": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["toolchainVersion", "packageId", "sourceHead", "sourceTree"],
        "properties": {
          "toolchainVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "packageId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "sourceHead": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
          "sourceTree": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" }
        }
      }
    }
  }
}
