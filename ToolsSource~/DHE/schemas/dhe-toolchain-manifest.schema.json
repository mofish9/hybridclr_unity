{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-toolchain-manifest.schema.json",
  "title": "HybridCLR DHE Toolchain Package Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "generatedAtUtc", "toolchainVersion", "contractVersion", "mode", "releaseReady", "pathSemantics", "packageIdAlgorithm", "packageId", "entryPoint", "commands", "layoutSha256", "sourceIdentity", "fileCount", "files"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-toolchain-manifest.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "toolchainVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
    "contractVersion": { "const": 1 },
    "mode": { "enum": ["Release", "Exploratory"] },
    "releaseReady": { "type": "boolean" },
    "pathSemantics": { "const": "package-relative-v1" },
    "packageIdAlgorithm": { "const": "sha256-canonical-manifest-v2" },
    "packageId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "entryPoint": { "enum": ["tool/HybridCLR.DheTool.csproj", "HybridCLR.DheTool.dll"] },
    "commands": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "layoutSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "sourceIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["head", "tree", "clean", "tracked"],
      "properties": {
        "head": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40,64}$" },
        "tree": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{40,64}$" },
        "clean": { "type": "boolean" },
        "tracked": { "type": "boolean" }
      }
    },
    "fileCount": { "type": "integer", "minimum": 1 },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "size", "sha256"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "size": { "type": "integer", "minimum": 0 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    }
  },
  "allOf": [
    {
      "if": { "properties": { "mode": { "const": "Release" } }, "required": ["mode"] },
      "then": { "properties": { "releaseReady": { "const": true } } }
    },
    {
      "if": { "properties": { "mode": { "const": "Exploratory" } }, "required": ["mode"] },
      "then": { "properties": { "releaseReady": { "const": false } } }
    }
  ]
}
