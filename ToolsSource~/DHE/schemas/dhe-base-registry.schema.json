{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-base-registry.schema.json",
  "title": "HybridCLR DHE Supported Base Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "pathSemantics", "registryId", "bases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-base-registry.json" },
    "pathSemantics": { "enum": ["registry-relative-v1", "workspace-absolute-v1"] },
    "registryId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "revision": { "type": "integer", "minimum": 1 },
    "parentRegistrySha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "generatedAtUtc": { "type": "string", "minLength": 1 },
    "bases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseId", "engineWorkflow", "baselineRoot", "nativeManifest", "buildIdentity"],
        "properties": {
          "baseId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "engineWorkflow": { "enum": ["Unity2021Standard", "Unity2022Fgs", "Tuanjie2022Fgs"] },
          "payloadVariantId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "label": { "type": "string", "minLength": 1, "maxLength": 256 },
          "baselineRoot": { "type": "string", "minLength": 1 },
          "nativeManifest": { "type": "string", "minLength": 1 },
          "buildIdentity": { "type": "string", "minLength": 1 },
          "aotMetadataRoot": { "type": ["string", "null"], "minLength": 1 }
        }
      }
    },
    "retiredBases": {
      "type": "array",
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseId", "engineWorkflow", "label", "retiredAtRevision", "reason"],
        "properties": {
          "baseId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "engineWorkflow": { "enum": ["Unity2021Standard", "Unity2022Fgs", "Tuanjie2022Fgs"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 256 },
          "retiredAtRevision": { "type": "integer", "minimum": 2 },
          "reason": { "type": "string", "minLength": 1, "maxLength": 512 }
        }
      }
    }
  }
}
