{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-workflow-failure.schema.json",
  "title": "HybridCLR DHE Workflow Failure Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "passed", "error", "outputRoot"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "pattern": "^hybridclr\\.dhe-[A-Za-z0-9._-]+-workflow-failure\\.json$" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "const": false },
    "error": { "type": "string", "minLength": 1 },
    "outputRoot": { "type": "string", "minLength": 1 }
  }
}
