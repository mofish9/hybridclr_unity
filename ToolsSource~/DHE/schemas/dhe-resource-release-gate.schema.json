{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-resource-release-gate.schema.json",
  "title": "HybridCLR DHE Multi-Base Resource Release Gate",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion", "format", "generatedAtUtc", "passed", "releaseReady",
    "toolchainRoot", "toolchainPackageId", "toolchainSourceHead", "toolchainSourceTree",
    "validationSourceRoot", "validationSourceHead", "validationSourceTree",
    "historicalToolEvidenceAccepted", "portableHistoricalToolEvidenceAccepted",
    "evidenceAuthorityPolicy", "evidenceAuthoritySet", "evidenceAuthoritySetSha256",
    "evidencePackageIds", "evidenceToolchainPackages",
    "resourceUpdateRoot", "resourceUpdateManifest",
    "resourceUpdateManifestSha256", "resourceUpdateValidation",
    "resourceUpdateValidationSha256", "releaseLedger", "releaseLedgerSha256",
    "parentReleaseLedgerSha256", "releaseChannelId", "releaseRevision",
    "initializationAuthorized", "expectedReleaseChannelId", "expectedReleaseRevision",
    "expectedReleaseLedgerSha256", "expectedPreviousReleaseLedgerSha256",
    "channelStateBound", "channelStateRoot", "channelSnapshot",
    "channelSnapshotSha256", "expectedChannelHeadSha256",
    "baseRegistryId", "baseRegistryRevision", "baseRegistrySha256", "activeBaseCount",
    "retiredBaseCount", "currentAssemblySetSha256", "payloadVariantSetSha256",
    "requireEngineMatrix", "engineMatrixCovered", "engineWorkflows",
    "exactActiveBaseCoverage", "playerReports", "errors", "warnings"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-resource-release-gate.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "const": true },
    "releaseReady": { "const": true },
    "toolchainRoot": { "type": "string", "minLength": 1 },
    "toolchainPackageId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "toolchainSourceHead": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "toolchainSourceTree": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "validationSourceRoot": { "type": ["string", "null"] },
    "validationSourceHead": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "validationSourceTree": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "historicalToolEvidenceAccepted": { "type": "boolean" },
    "portableHistoricalToolEvidenceAccepted": { "type": "boolean" },
    "evidenceAuthorityPolicy": { "enum": ["none", "explicit-package-id-set-v1"] },
    "evidenceAuthoritySet": { "type": ["string", "null"] },
    "evidenceAuthoritySetSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "evidencePackageIds": {
      "type": "array", "minItems": 1, "maxItems": 128, "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
    },
    "evidenceToolchainPackages": {
      "type": "array", "minItems": 1, "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "packageId", "packageRoot", "toolchainVersion", "sourceHead", "sourceTree"
        ],
        "properties": {
          "packageId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "packageRoot": { "type": "string", "minLength": 1 },
          "toolchainVersion": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$" },
          "sourceHead": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
          "sourceTree": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" }
        }
      }
    },
    "resourceUpdateRoot": { "type": "string", "minLength": 1 },
    "resourceUpdateManifest": { "type": "string", "minLength": 1 },
    "resourceUpdateManifestSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "resourceUpdateValidation": { "type": "string", "minLength": 1 },
    "resourceUpdateValidationSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "releaseLedger": { "type": "string", "minLength": 1 },
    "releaseLedgerSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "parentReleaseLedgerSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "releaseChannelId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "releaseRevision": { "type": "integer", "minimum": 1 },
    "initializationAuthorized": { "type": "boolean" },
    "expectedReleaseChannelId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "expectedReleaseRevision": { "type": "integer", "minimum": 1 },
    "expectedReleaseLedgerSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "expectedPreviousReleaseLedgerSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "channelStateBound": { "type": "boolean" },
    "channelStateRoot": { "type": ["string", "null"] },
    "channelSnapshot": { "type": ["string", "null"] },
    "channelSnapshotSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "expectedChannelHeadSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "baseRegistryId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "baseRegistryRevision": { "type": "integer", "minimum": 1 },
    "baseRegistrySha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "activeBaseCount": { "type": "integer", "minimum": 1, "maximum": 1024 },
    "retiredBaseCount": { "type": "integer", "minimum": 0, "maximum": 1024 },
    "currentAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "payloadVariantSetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "requireEngineMatrix": { "type": "boolean" },
    "engineMatrixCovered": { "type": "boolean" },
    "engineWorkflows": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "uniqueItems": true,
      "items": { "enum": ["Unity2021Standard", "Unity2022Fgs", "Tuanjie2022Fgs"] }
    },
    "exactActiveBaseCoverage": { "const": true },
    "playerReports": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "baseId", "engineWorkflow", "target", "payloadVariantId", "aotMetadataSetId",
          "currentAssemblySetSha256", "changedMethodCount", "interpreterEntryCount",
          "aotEntryCount", "toolchainPackageId", "toolchainAuthorityMode",
          "report", "reportSha256"
        ],
        "properties": {
          "baseId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "engineWorkflow": { "enum": ["Unity2021Standard", "Unity2022Fgs", "Tuanjie2022Fgs"] },
          "target": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "payloadVariantId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "aotMetadataSetId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "currentAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "changedMethodCount": { "type": "integer", "minimum": 0 },
          "interpreterEntryCount": { "type": "integer", "minimum": 0 },
          "aotEntryCount": { "type": "integer", "minimum": 0 },
          "toolchainPackageId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "toolchainAuthorityMode": {
            "enum": ["current-package", "authorized-historical-package", "git-ancestry"]
          },
          "report": { "type": "string", "minLength": 1 },
          "reportSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "errors": { "type": "array", "maxItems": 0 },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "releaseRevision": { "const": 1 } }, "required": ["releaseRevision"] },
      "then": {
        "properties": {
          "initializationAuthorized": { "const": true },
          "parentReleaseLedgerSha256": { "type": "null" },
          "expectedPreviousReleaseLedgerSha256": { "type": "null" }
        }
      },
      "else": {
        "properties": {
          "initializationAuthorized": { "const": false },
          "parentReleaseLedgerSha256": { "type": "string" },
          "expectedPreviousReleaseLedgerSha256": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "requireEngineMatrix": { "const": true } }, "required": ["requireEngineMatrix"] },
      "then": { "properties": { "engineMatrixCovered": { "const": true }, "engineWorkflows": { "minItems": 3 } } }
    },
    {
      "if": { "properties": { "channelStateBound": { "const": true } }, "required": ["channelStateBound"] },
      "then": {
        "properties": {
          "channelStateRoot": { "type": "string", "minLength": 1 },
          "channelSnapshot": { "type": "string", "minLength": 1 },
          "channelSnapshotSha256": { "type": "string" }
        }
      },
      "else": {
        "properties": {
          "channelStateRoot": { "type": "null" },
          "channelSnapshot": { "type": "null" },
          "channelSnapshotSha256": { "type": "null" },
          "expectedChannelHeadSha256": { "type": "null" }
        }
      }
    },
    {
      "if": { "properties": { "evidenceAuthorityPolicy": { "const": "explicit-package-id-set-v1" } }, "required": ["evidenceAuthorityPolicy"] },
      "then": {
        "properties": {
          "evidenceAuthoritySet": { "type": "string", "minLength": 1 },
          "evidenceAuthoritySetSha256": { "type": "string" }
        }
      },
      "else": {
        "properties": {
          "evidenceAuthoritySet": { "type": "null" },
          "evidenceAuthoritySetSha256": { "type": "null" },
          "portableHistoricalToolEvidenceAccepted": { "const": false }
        }
      }
    }
  ]
}
