{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-base-runner-catalog.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "pathSemantics", "baseRegistryId", "baseRegistryRevision", "baseRegistrySha256", "bases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-base-runner-catalog.json" },
    "pathSemantics": { "const": "config-relative-v1" },
    "baseRegistryId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,128}$" },
    "baseRegistryRevision": { "type": "integer", "minimum": 1 },
    "baseRegistrySha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "bases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 1024,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["baseId", "runnerKind", "assetRoot", "buildIdentity", "baseWorkflowReport", "playerExecutable", "workingDirectory", "playerArguments", "immutableFiles", "playerWorkflowReportTemplate"],
        "properties": {
          "baseId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "runnerKind": { "enum": ["process", "prequalified"] },
          "assetRoot": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
          "buildIdentity": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
          "baseWorkflowReport": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
          "playerExecutable": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
          "workingDirectory": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 },
          "playerArguments": {
            "type": ["array", "null"],
            "maxItems": 256,
            "items": { "type": "string", "maxLength": 4096 }
          },
          "immutableFiles": {
            "type": "array",
            "maxItems": 64,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
          },
          "playerWorkflowReportTemplate": { "type": ["string", "null"], "minLength": 1, "maxLength": 4096 }
        }
      }
    }
  }
}
