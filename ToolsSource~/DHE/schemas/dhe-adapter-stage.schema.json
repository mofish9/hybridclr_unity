{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-adapter-stage.schema.json",
  "title": "HybridCLR DHE Adapter Runtime Plan Stage Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "generatedAtUtc", "passed", "target", "runtimePlanPath", "handoffPlanPath", "assemblyCount", "assemblyNames"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-adapter-stage.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "const": true },
    "target": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
    "runtimePlanPath": { "type": "string", "minLength": 1 },
    "handoffPlanPath": { "type": "string", "minLength": 1 },
    "assemblyCount": { "type": "integer", "minimum": 1 },
    "assemblyNames": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
  }
}
