{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-resource-release-plan-config.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "pathSemantics", "resourceUpdateRoot", "runnerCatalog", "outputRoot", "qualificationOutputRoot", "channelSnapshot", "expectedChannelSnapshotSha256", "expectedToolchainPackageId", "evidenceToolchainRoots", "requireEngineMatrix", "timeoutSeconds"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-resource-release-plan-config.json" },
    "pathSemantics": { "const": "config-relative-v1" },
    "resourceUpdateRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "runnerCatalog": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "outputRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "qualificationOutputRoot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "channelSnapshot": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "expectedChannelSnapshotSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "expectedToolchainPackageId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "evidenceToolchainRoots": {
      "type": "array",
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 4096 }
    },
    "requireEngineMatrix": { "type": "boolean" },
    "timeoutSeconds": { "type": "integer", "minimum": 1, "maximum": 3600 }
  }
}
